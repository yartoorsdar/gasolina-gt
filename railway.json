{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "envs": [
      {
        "key": "EIA_API_KEY",
        "value": "${EIA_API_KEY}"
      },
      {
        "key": "GEMINI_API_KEY",
        "value": "${GEMINI_API_KEY}"
      }
    ]
  }
}
