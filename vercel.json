{
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/resumen\\.json$", "dest": "/resumen.json" },
    { "src": "/consolidado\\.json$", "dest": "/consolidado.json" },
    { "src": "/precios_combustible\\.json$", "dest": "/precios_combustible.json" },
    { "src": "/petroleo\\.json$", "dest": "/petroleo.json" },
    { "src": "/noticias\\.json$", "dest": "/noticias.json" },
    { "src": "/historial_precios\\.json$", "dest": "/historial_precios.json" },
    { "src": "/historial_petroleo\\.json$", "dest": "/historial_petroleo.json" },
    { "src": "/web/(.*)", "dest": "/web/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
